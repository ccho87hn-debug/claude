{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('coins').isNumber() && newData.child('coins').val() >= 0 && (!data.exists() ? newData.child('coins').val() === 1000 : newData.child('name').val() === data.child('name').val())"
      }
    }
  }
}
