rules_version = '2';
// Paste into Firebase console > Firestore Database > 규칙(Rules) and publish.
// Each player can only read and change their own coins and record, and can't rename themselves.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.coins == 1000;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.coins is int && request.resource.data.coins >= 0;
    }
  }
}
