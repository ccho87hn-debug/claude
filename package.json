{
  "name": "homework-goals",
  "productName": "숙제 & 목표",
  "version": "1.3.1",
  "description": "오늘의 숙제와 이번 달 목표 달성률을 관리하는 PC 앱",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.homeworkgoals.app",
    "productName": "숙제 & 목표",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "mac": { "target": "dmg", "category": "public.app-category.education", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "homework-goals-setup-${version}.exe" }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
